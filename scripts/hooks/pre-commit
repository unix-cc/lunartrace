#!/bin/sh
# 仓库唯一的 L1 门禁入口（只能有一份，多份必然漂移）。
# 安装：scripts/install-hooks.ps1（Windows）或 scripts/install-hooks.sh
# 说明：本项目不使用 pre-commit 框架，因此不涉及它在 stash/restore 时锁定 .husky/pre-commit 的
#       那个 Windows 文件锁问题；钩子只是普通 git 钩子。
set -e

PYTHON=python
command -v python >/dev/null 2>&1 || PYTHON=python3

CHANGED="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$CHANGED" ]; then
    echo "[pre-commit] 没有暂存改动，跳过"
    exit 0
fi

echo "[pre-commit] 1/3 隐私红线（清单权限 / 日志 / SharedPreferences / PIN 派生）"
"$PYTHON" scripts/check-privacy-guards.py

echo "[pre-commit] 2/3 文档一致性（入口漂移 / spec 状态 / CODEOWNERS 是否空转）"
"$PYTHON" scripts/check-docs.py

if printf '%s\n' "$CHANGED" | grep -qE '^app/.*\.(kt|kts)$|^config/detekt/|^gradle/|^settings\.gradle\.kts$|^build\.gradle\.kts$'; then
    # 门禁要有强制力就必须能真的跑起来：JDK 缺失时明确失败，而不是"跳过并假装通过"
    if [ -z "${JAVA_HOME:-}" ] && ! command -v java >/dev/null 2>&1; then
        echo "[pre-commit] 无法运行 Gradle：既没有 JAVA_HOME，也没有 java 命令。" >&2
        echo "  解决方式（任选其一）：" >&2
        echo "   1) 设置 JAVA_HOME 指向 JDK 17 后再提交" >&2
        echo "   2) 在 ~/.gradle/gradle.properties 中写 org.gradle.java.home=<JDK 17 路径>" >&2
        echo "  详见 DEVELOP.md 第 0 节。" >&2
        exit 1
    fi
    echo "[pre-commit] 3/3 Kotlin 静态检查 + 单元测试（Gradle 增量）"
    ./gradlew --console=plain detekt testDebugUnitTest
else
    echo "[pre-commit] 3/3 本次未改动 Kotlin 代码，跳过 Gradle 检查"
fi
