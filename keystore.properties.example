# 复制为 keystore.properties 并填入真实值（该文件已在 .gitignore 中，不会入库）。
# 生成密钥库（只做一次，之后务必离线备份——丢了就无法给已安装用户推送升级）：
#   keytool -genkeypair -v -keystore lunartrace.jks -keyalg RSA -keysize 2048 -validity 10000 -alias lunartrace
#
# 四个键缺任何一个，release 包都会被视为"不可签名"，assembleRelease 会直接失败（见 DEVELOP.md §3）。

storeFile=../lunartrace.jks
storePassword=change-me
keyAlias=lunartrace
keyPassword=change-me
